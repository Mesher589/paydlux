{
  "name": "@paydlux/agent",
  "version": "0.1.11",
  "description": "Payments for AI agents that a human approves. Spending mandates enforced on the Stellar ledger: 2-of-2 vault, pre-authorised transaction envelopes, HTTP 402, USDC.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "phone-app/index.html",
    "phone-app/app.js",
    "phone-app/xdr.js",
    "phone-app/app.css",
    "phone-app/manifest.webmanifest",
    "phone-app/icon-192.png",
    "phone-app/icon-512.png",
    "portal-app/portal.js",
    "portal-app/portal.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "node sdk/demo.ts",
    "demo:stellar": "tsx stellar/demo.ts",
    "setup:stellar": "tsx stellar/onboard.ts",
    "story:stellar": "tsx stellar/story.ts",
    "story:tls": "tsx stellar/story.ts --tls --split",
    "test:tls": "tsx stellar/tls-check.ts",
    "test": "cd contracts && forge test",
    "test:stellar": "tsx stellar/demo.ts",
    "test:portal": "tsx stellar/xss-check.ts",
    "test:mandate": "tsx stellar/mandate-check.ts",
    "test:phone": "tsx stellar/phone-check.ts && tsx stellar/desk-split-check.ts && tsx stellar/mandate-check.ts && tsx stellar/e2e-phone.ts && tsx phone-app/xdr-check.ts && tsx phone-app/app-check.ts && tsx phone-app/desk-app-check.ts && tsx ios/bridge-check.ts",
    "test:ios": "tsx ios/bridge-check.ts",
    "test:link": "swiftc ios/PaydluxApprover/LinkResolver.swift ios/Checks/linkcheck/main.swift -o \"$TMPDIR/linkcheck\" && \"$TMPDIR/linkcheck\"",
    "test:seed": "DEVELOPER_DIR=/Library/Developer/CommandLineTools /usr/bin/swiftc -target arm64-apple-macosx14.0 ios/PaydluxApprover/Seed.swift ios/PaydluxApprover/Hex.swift ios/Checks/main.swift -o \"$TMPDIR/seedcheck\" && \"$TMPDIR/seedcheck\"",
    "typecheck": "tsc --noEmit",
    "app": "tsx stellar/cli.ts",
    "app:mainnet": "tsx stellar/cli.ts setup --mainnet"
  },
  "keywords": [
    "x402",
    "http-402",
    "stellar",
    "usdc",
    "ai-agents",
    "agent-payments",
    "escrow",
    "payments"
  ],
  "author": "Paydlux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mesher589/paydlux.git"
  },
  "homepage": "https://paydlux.com",
  "bugs": {
    "url": "https://github.com/Mesher589/paydlux/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.13",
    "xrpl": "^5.3.0"
  },
  "bin": {
    "paydlux": "dist/cli.js"
  }
}
